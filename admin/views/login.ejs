<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Admin login</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background: #eef2f7; }
    </style>
</head>
<body class="d-flex align-items-center min-vh-100">
    <main class="container">
        <div class="card shadow-sm border-0 mx-auto p-4" style="max-width: 400px;">
            <h1 class="h2">Admin portal</h1>
            <p class="text-secondary">Sign in to manage your store.</p>
            <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>
            <form method="post" action="/admin/login">
                <div class="mb-3">
                    <label class="form-label" for="email">Email</label>
                    <input class="form-control" id="email" name="email" type="email" required autofocus>
                </div>
                <div class="mb-3">
                    <label class="form-label" for="password">Password</label>
                    <input class="form-control" id="password" name="password" type="password" required>
                </div>
                <button class="btn btn-primary w-100" type="submit">Sign in</button>
            </form>
        </div>
    </main>
</body>
</html>
