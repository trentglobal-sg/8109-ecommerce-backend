<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Admin dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background: #eef2f7; }
    </style>
</head>
<body>
    <nav class="navbar navbar-dark bg-dark">
        <div class="container">
            <span class="navbar-brand">Store administration</span>
        </div>
    </nav>
    <main class="container py-5">
        <section class="card shadow-sm border-0 p-4">
            <h1 class="h2">Welcome, <%= admin.name %></h1>
            <p class="text-secondary">You are signed in as an administrator.</p>
        </section>
        <section class="row g-4 mt-1">
            <div class="col-md-6">
                <div class="card shadow-sm border-0 p-4">Signed-in account<strong class="fs-4"><%= admin.email %></strong></div>
            </div>
            <div class="col-md-6">
                <div class="card shadow-sm border-0 p-4">Access level<strong class="fs-4"><%= admin.role %></strong></div>
            </div>
        </section>
    </main>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>