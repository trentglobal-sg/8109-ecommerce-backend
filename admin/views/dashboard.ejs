<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Admin dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background: #eef2f7; }
        .message { white-space: normal; }
        .message p:last-child { margin-bottom: 0; }
        .message.admin { background: #e1e8ff; }
        .message.agent { background: white; }
    </style>
</head>
<body>
    <nav class="navbar navbar-dark bg-dark">
        <div class="container">
            <span class="navbar-brand">Store administration</span>
            <form method="post" action="/admin/logout">
                <button class="btn btn-outline-light" type="submit">Sign out</button>
            </form>
        </div>
    </nav>
    <main class="container py-5">
        <section class="card shadow-sm border-0 p-4">
            <h1 class="h2">Welcome, <%= admin.name %></h1>
            <p class="text-secondary">You are signed in as an administrator. This dashboard is ready for store management features.</p>
            <div>
                <a class="btn btn-primary" href="/admin/chat">Open store assistant</a>
            </div>
        </section>
        <section class="row g-4 mt-1">
            <div class="col-md-6">
                <div class="card shadow-sm border-0 p-4">Signed-in account<strong class="fs-4"><%= admin.email %></strong></div>
            </div>
            <div class="col-md-6">
                <div class="card shadow-sm border-0 p-4">Access level<strong class="fs-4"><%= admin.role %></strong></div>
            </div>
        </section>
        <% if (openChat) { %>
        <section class="card shadow-sm border-0 p-4 mt-4">
            <h2 class="h3">Store assistant</h2>
            <p class="text-secondary">Ask about products, customer orders, or sales totals. Replies support Markdown.</p>
            <div id="messages" class="border rounded bg-light p-3" style="min-height: 180px; max-height: 360px; overflow-y: auto;"></div>
            <form id="chat-form" class="input-group mt-3">
                <input class="form-control" id="message" name="message" placeholder="e.g. Show me pending orders for customer@example.com" autocomplete="off" required>
                <button class="btn btn-primary" type="submit">Send</button>
            </form>
        </section>
        <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/dompurify@3.1.6/dist/purify.min.js"></script>
        <script src="/admin/assets/js/dashboard.js"></script>
        <% } %>
    </main>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
